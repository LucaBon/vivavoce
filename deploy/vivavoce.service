# systemd unit for an always-on Linux host (e.g. Raspberry Pi / mini-PC).
# Install:
#   sudo cp deploy/vivavoce.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vivavoce
# Adapt WorkingDirectory and the venv python path to your setup. The LMS server is
# auto-discovered on the LAN; add `--lms http://IP:9000` to ExecStart to pin it.
[Unit]
Description=Vivavoce — local voice server for Daphile/LMS
# time-sync.target: on a board without an RTC (a Pi) the clock reads the
# fake-hwclock time until NTP answers. The trial window is one timestamp
# compared against that clock, so starting before the time is real used to
# open a window already 56 years expired.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
WorkingDirectory=/opt/vivavoce
# Unbuffered, like both sibling deploy paths (Dockerfile, entrypoint.sh).
# Under systemd stdout is a pipe, not a terminal, so Python buffers it in 4 KiB
# blocks — and the server's whole startup diagnostic is well under that. The
# `systemctl enable --now && journalctl -u vivavoce` sequence in DEPLOY.md
# therefore showed nothing at all for a server that had started perfectly, for
# as long as it kept running. Both spellings on purpose: the flag survives an
# ExecStart edited to call a wrapper, the variable survives one that drops it.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/vivavoce/.venv/bin/python -u localvoice/server.py \
    --cert /opt/vivavoce/cert.pem --key /opt/vivavoce/key.pem \
    --data-dir /opt/vivavoce/data
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
